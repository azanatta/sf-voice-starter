# Copy to `.env` and adjust — or run `npm run configure` for a form with validation.
# GENERATED from config/settings-schema.ts. Edit the schema, not this file.
#
# The setup script reads process.env directly; load this with your shell, direnv, or
# `node --env-file=.env`.

# ------------------------------------------------------------------------------------------
# Dev Hub
# ------------------------------------------------------------------------------------------
# An authenticated Dev Hub. Authenticate once with: sf org login web --set-default-dev-hub --alias scvhub
# SCV_DEVHUB_ALIAS=scvhub

# ------------------------------------------------------------------------------------------
# Scratch org
# ------------------------------------------------------------------------------------------
# Alias the new org is registered under.
# SCV_ORG_ALIAS=scv-dev

# How long the scratch org lives. Maximum 30.
# SCV_ORG_DURATION_DAYS=7

# Overrides the edition in the scratch definition. Leave empty to use Developer.
# Options: (empty) | Developer | Enterprise
# SCV_ORG_EDITION=

# Reuse an org with the same alias if it is still alive, instead of creating one.
# SCV_REUSE_ORG=true

# Optional top-up for the features in config/project-scratch-def.json, e.g. to raise licence counts. Normally empty.
# SCV_VOICE_FEATURES=

# ------------------------------------------------------------------------------------------
# Permissions
# ------------------------------------------------------------------------------------------
# Assigned to the running user. The first three come from the Voice feature; the last two are the BYO-channel set and the presence-status set this project deploys.
# SCV_PERMISSION_SETS=ContactCenterAdminExternalTelephony,ContactCenterAgentExternalTelephony,ContactCenterSupervisorExternalTelephony,ContactCenterBringYourOwnChannelUser,Service_Presence_Statuses_Access

# ------------------------------------------------------------------------------------------
# CSP trusted sites
# ------------------------------------------------------------------------------------------
# Domains your package loads from, comma-separated. Use "Name|https://url" to choose the API name. Leave empty to skip. Without these, the browser blocks the package and it looks broken rather than unconfigured.
# SCV_CSP_SITES=

# Stored on every site created, so their origin is obvious in Setup.
# SCV_CSP_DESCRIPTION=Added by the SCV org setup script

# Which contexts the directives apply to.
# Options: All | LEX | Communities | VisualForce
# SCV_CSP_CONTEXT=All

# A softphone needs this. Enabling it also deploys SecuritySettings.enablePermissionsPolicy, without which the flag does nothing.
# SCV_CSP_MICROPHONE=true

# Only needed for video. Also requires the permissions policy.
# SCV_CSP_CAMERA=false

# Script interface loads (XHR, WebSocket). Needed by most telephony connectors.
# SCV_CSP_CONNECT_SRC=true

# iframe loads. Needed when the vendor embeds its own UI.
# SCV_CSP_FRAME_SRC=true

# Image loads.
# SCV_CSP_IMG_SRC=true

# Stylesheet loads.
# SCV_CSP_STYLE_SRC=true

# Font loads.
# SCV_CSP_FONT_SRC=true

# Audio and video loads. Relevant for call recordings and ringtones.
# SCV_CSP_MEDIA_SRC=true

# ------------------------------------------------------------------------------------------
# Certificate
# ------------------------------------------------------------------------------------------
# Generate a self-signed certificate in the org for the contact center to reference as its public key.
# SCV_CREATE_CERTIFICATE=true

# Shown in Setup.
# SCV_CERT_LABEL=Certificate_SF

# Written into the contact center as "Certificate Unique Name" (certDevName). The two cannot differ.
# SCV_CERT_NAME=Certificate_SF

# Certificate key size in bits.
# Options: 2048 | 4096
# SCV_CERT_KEY_SIZE=2048

# Whether the private key can be exported from the org.
# SCV_CERT_EXPORTABLE=true

# ------------------------------------------------------------------------------------------
# Presence statuses
# ------------------------------------------------------------------------------------------
# Deploy the Online and Busy statuses and wire their ids into the contact center. Without a status a rep cannot go available.
# SCV_CREATE_PRESENCE_STATUSES=true

# The status meaning "available for calls". Carries the Phone service channel.
# SCV_PRESENCE_READY=Online

# The status meaning "not available". Carries no channel, which is what makes Salesforce treat it as Away.
# SCV_PRESENCE_NOT_READY=Busy

# Permission set granting both statuses. Deployed by this project, then assigned.
# SCV_PRESENCE_PERMSET=Service_Presence_Statuses_Access

# ------------------------------------------------------------------------------------------
# Vendor package
# ------------------------------------------------------------------------------------------
# The vendor package to install. An 04t… id or an install URL containing one. Leave empty to stop at "ready to install".
# SCV_PACKAGE_VERSION_ID=

# Only if the vendor protected the package version.
# SCV_PACKAGE_INSTALL_KEY=

# Managed SCV packages are large; installs of 20+ minutes are normal.
# SCV_PACKAGE_WAIT_MINUTES=30

# Which profiles get access on install.
# Options: AdminsOnly | AllUsers
# SCV_PACKAGE_SECURITY=AdminsOnly

# ------------------------------------------------------------------------------------------
# Contact center
# ------------------------------------------------------------------------------------------
# Import the vendor XML through the Setup wizard after the package is installed.
# SCV_CREATE_CONTACT_CENTER=true

# Path to your telephony provider's contact center definition XML, in the Setup import format. The provider and internal name are read out of this file. Leave empty to skip the contact center phases.
# SCV_CC_DEFINITION_FILE=

# ConversationVendorInfo developer name. Leave empty to read it from the XML, which is safer.
# SCV_VENDOR_INFO=

# Leave empty to read reqInternalName from the XML. Setting it wrong makes every run re-import.
# SCV_CC_INTERNAL_NAME=

# Informational only; the XML's own value wins on import.
# SCV_CC_DISPLAY_NAME=Dev Contact Center

# ------------------------------------------------------------------------------------------
# Console app
# ------------------------------------------------------------------------------------------
# Deploy a Lightning console app whose utility bar carries the vendor bridge and Omni-Channel.
# SCV_CREATE_CONSOLE_APP=true

# API name of the console app. The softphone does not render in a standard app.
# SCV_CONSOLE_APP=SCV

# Shown in the App Launcher.
# SCV_CONSOLE_APP_LABEL=SCV

# Your telephony vendor's utility bar component, namespace included. It ships inside their managed package, so the app cannot deploy without it installed. Leave empty to skip the console app phase.
# SCV_BRIDGE_COMPONENT=

# Label for the bridge utility item, as a rep sees it in the utility bar.
# SCV_BRIDGE_LABEL=Softphone

# The "Start automatically" checkbox. With it off the bridge loads only when a rep opens the utility, so calls can be missed until they do.
# SCV_BRIDGE_START_AUTO=true

# Utility panel width.
# SCV_BRIDGE_WIDTH=340

# Utility panel height.
# SCV_BRIDGE_HEIGHT=480

# Permission set granting visibility of the app, created and assigned by this project. Additive, unlike deploying a Profile.
# SCV_APP_PERMSET=SCV_App_Access

# ------------------------------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------------------------------
# Run the browser visibly. The fastest way to debug a broken Setup selector.
# SCV_HEADED=false

# Delay each browser action. Debugging aid; 0 for real runs.
# SCV_SLOWMO_MS=0

# Per-interaction timeout. Setup pages are slow.
# SCV_ACTION_TIMEOUT_MS=30000

# Page-load timeout. Lightning Setup can take 30s+ on a cold org.
# SCV_NAV_TIMEOUT_MS=90000

# Where screenshots are written.
# SCV_ARTIFACT_DIR=artifacts

# Not only on failure.
# SCV_SCREENSHOT_ALL=true
